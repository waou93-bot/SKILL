{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "required": [
    "site_url",
    "language",
    "target_country",
    "business_description",
    "products_services",
    "target_audiences",
    "conversion_goals"
  ],
  "properties": {
    "site_url": {
      "type": "string",
      "format": "uri"
    },
    "language": {
      "type": "string"
    },
    "target_country": {
      "type": "string"
    },
    "business_description": {
      "type": "string"
    },
    "products_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_audiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conversion_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "geographic_scope": {
      "type": "string"
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand_voice": {
      "type": "string"
    },
    "expert_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cms_provider": {
      "type": "string"
    },
    "publishing_mode": {
      "enum": [
        "draft",
        "review",
        "automatic"
      ],
      "default": "draft"
    },
    "publishing_frequency": {
      "type": "string"
    },
    "monthly_budget": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "optional_search_console_connection": {
      "type": [
        "string",
        "null"
      ]
    },
    "optional_analytics_connection": {
      "type": [
        "string",
        "null"
      ]
    },
    "backlink_network_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
