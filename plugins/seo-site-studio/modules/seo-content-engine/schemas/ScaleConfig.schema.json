{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScaleConfig",
  "type": "object",
  "properties": {
    "global_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "lease_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 86400
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site_id": {
            "type": "string"
          },
          "site_url": {
            "type": "string",
            "format": "uri"
          },
          "publishing_mode": {
            "enum": [
              "draft",
              "review",
              "automatic"
            ]
          },
          "monthly_budget": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "paused": {
            "type": "boolean"
          }
        },
        "required": [
          "site_id",
          "site_url",
          "publishing_mode",
          "monthly_budget",
          "currency",
          "concurrency",
          "paused"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "global_concurrency",
    "lease_seconds",
    "max_attempts",
    "sites"
  ],
  "additionalProperties": false
}
