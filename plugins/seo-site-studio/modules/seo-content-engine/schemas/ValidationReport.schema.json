{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationReport",
  "type": "object",
  "required": [
    "status",
    "evidence",
    "assumptions",
    "missing_data",
    "generated_at",
    "next_action",
    "article_version",
    "checks",
    "blocking_defects",
    "sensitive_topic",
    "qualified_approval",
    "reviewer"
  ],
  "properties": {
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "draft",
        "local_draft",
        "failed",
        "needs_reconciliation"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "source",
          "observed_at",
          "detail"
        ],
        "properties": {
          "kind": {
            "enum": [
              "observed",
              "supplied",
              "hypothetical",
              "fictional"
            ]
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_action": {
      "type": "string"
    },
    "article_version": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "result",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "blocking_defects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sensitive_topic": {
      "type": "boolean"
    },
    "qualified_approval": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
