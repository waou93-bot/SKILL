{
  "type": "object",
  "required": ["schema_version", "run_id", "target", "site_context_sha256", "site_snapshots", "status", "errors", "warnings", "http", "browser", "performance"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "run_id": {"type": "string"},
    "site_context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "site_snapshots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "status": {"type": "string", "enum": ["PASS", "BLOCKED", "NOT_RUN"]},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "http": {"type": "object", "required": ["status", "complete", "pages", "evidence_id"]},
    "browser": {"type": "object", "required": ["status"]},
    "performance": {"type": "object", "required": ["status"]},
    "target": {"type": "string"}, "created_at": {"type": "string"}, "scope": {"type": "string"}
  },
  "additionalProperties": false
}
